# ============================================================
# Trader Operation — variáveis de ambiente (DESENVOLVIMENTO)
# ============================================================
# Copie para .env:  cp .env.example .env
# Valores abaixo são só para dev local. Nunca use em produção
# e nunca commite o .env.
# ============================================================

# --- Portas no host (mude se já houver outro serviço usando) ---
# Padrões fora de 5432/5433/6379 para conviver com os containers
# do OmniCore e do SGCE, que sobem junto com o Docker Desktop.
TRADER_POSTGRES_PORT=5434
TRADER_REDIS_PORT=6380
TRADER_S3_PORT=8333
TRADER_BACKEND_PORT=8090
TRADER_FRONTEND_PORT=5173
TRADER_MOTOR_PORT=8091

# --- Postgres ---
TRADER_POSTGRES_USER=trader
TRADER_POSTGRES_PASSWORD=trader_dev
TRADER_POSTGRES_DB=trader

# --- Armazenamento S3 (SeaweedFS em dev) ---
# As chaves precisam bater com infra/seaweedfs/s3.json
TRADER_S3_ACCESS_KEY=trader_dev
TRADER_S3_SECRET_KEY=trader_dev_secret
TRADER_S3_BUCKET=trader-arquivos

# --- nucleo-backend ---
# Segredo do JWT (mínimo 64 caracteres). Em produção, gere um aleatório:
#   openssl rand -base64 64 | tr -d '\n'
TRADER_JWT_SECRET=dev-somente-local-troque-em-producao-0123456789abcdef0123456789abcdef

# --- motor-quant ---
# Shared secret entre serviços internos (nucleo-backend/conector ↔ motor-quant).
# Em produção, gere um aleatório e rotacione periodicamente.
MOTOR_SHARED_TOKEN=dev-interno-trocar-em-producao

# Perfil de seed: dev (carrega CSVs sintéticos), producao (vazio, espera o conector),
# vazio (nada carregado — teste).
TRADER_MOTOR_SEED=dev
